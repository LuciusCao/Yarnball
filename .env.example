# ===== 高德开放平台 (https://lbs.amap.com) =====
# 「Web端(JS API)」类型的 key，用于前端地图渲染
AMAP_JS_KEY=
# 「Web服务」类型的 key，用于服务端 POI 搜索 / 路径规划 / 距离矩阵
AMAP_SERVER_KEY=
# JS API 安全密钥（2021-12-02 之后申请的 key 必须配套）
AMAP_JS_SECRET=

# ===== 数据库 =====
# SQLite 文件路径（better-sqlite3 内嵌，无需 Docker/Postgres）。
# 支持纯路径或 file: 前缀；不设置时默认 ~/.yarnball/yarnball.db
# 注意：M80 起已改用 SQLite，postgres:// 等连接串会直接报错，不再被当成路径。
# 旧 Postgres 数据迁移：pnpm -C apps/server migrate:pg-legacy（见 scripts/migrate-pg-legacy.mjs 头注释）
# DATABASE_URL=/path/to/yarnball.db

# ===== 服务 =====
SERVER_PORT=18788
# 监听地址。默认仅本机 loopback：/api 无鉴权，绑 0.0.0.0 会把整个行程 API
# （含 spawn agent 的 POST /api/agents）暴露给局域网。LAN 调试再显式改：
# SERVER_HOST=0.0.0.0
SERVER_HOST=127.0.0.1
# 前端地址（CORS 白名单）
WEB_ORIGIN=http://localhost:15173
# web 静态产物目录覆盖（可选；默认自动探测 apps/web/dist，Tauri 打包后由壳注入）
# YARNBALL_WEB_DIST_DIR=/path/to/web/dist

# ===== 网络代理（可选，仅海外行程的上游请求需要） =====
# 服务端访问海外地理服务（Photon / Nominatim / OSRM）时支持标准代理环境变量：
# HTTPS_PROXY > ALL_PROXY > HTTP_PROXY（大小写均认），并遵守 NO_PROXY。
# 国内高德请求永远直连，不受代理影响。不设代理则直连海外上游。
# HTTPS_PROXY=http://127.0.0.1:7897
# ALL_PROXY=socks5://127.0.0.1:7897
